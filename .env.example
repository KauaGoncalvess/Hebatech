# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Onde achar: Supabase → Project Settings → API
#
# Sem estas variáveis o site roda normalmente com o catálogo do arquivo
# src/data/seed.ts, mas o painel em /admin fica indisponível.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada pelo `npm run seed`, rodando na sua máquina.
# NUNCA coloque esta chave na Vercel nem em variável NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
